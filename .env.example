# Documentation only; deploy.sh prompts and generates a protected host-local .env.
UPLOAD_LOCATION=/absolute/path/to/selected/Immich
DB_DATA_LOCATION=/absolute/path/on/internal/disk/postgres
IMMICH_VERSION=v3.2.4
TZ=America/Toronto
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
DB_PASSWORD=GENERATED_ON_TARGET
